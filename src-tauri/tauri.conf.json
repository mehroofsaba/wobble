{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wobble",
  "version": "0.1.0",
  "identifier": "app.wobble.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hub",
        "title": "Wobble",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": true
      },
      {
        "label": "pet",
        "title": "Wobble Pet",
        "url": "pet.html",
        "width": 400,
        "height": 590,
        "x": 200,
        "y": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
